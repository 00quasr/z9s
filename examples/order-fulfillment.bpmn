<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_OrderFulfillment" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="order-fulfillment" name="Order fulfillment" isExecutable="true">
    <bpmn:startEvent id="OrderReceived" name="Order received">
      <bpmn:outgoing>Flow_ToValidate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToValidate" sourceRef="OrderReceived" targetRef="ValidateOrder" />
    <bpmn:serviceTask id="ValidateOrder" name="Validate order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="z9s-sim-validate" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToValidGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToValidGateway" sourceRef="ValidateOrder" targetRef="OrderValid" />
    <bpmn:exclusiveGateway id="OrderValid" name="Order valid?" default="Flow_Valid">
      <bpmn:incoming>Flow_ToValidGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Valid" name="valid" sourceRef="OrderValid" targetRef="ForkFulfillment" />
    <bpmn:sequenceFlow id="Flow_Invalid" name="invalid" sourceRef="OrderValid" targetRef="OrderRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=valid = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="OrderRejected" name="Order rejected">
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="ForkFulfillment" name="">
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_ToInventory</bpmn:outgoing>
      <bpmn:outgoing>Flow_ToPayment</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_ToInventory" sourceRef="ForkFulfillment" targetRef="ReserveInventory" />
    <bpmn:serviceTask id="ReserveInventory" name="Reserve inventory">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="z9s-sim-inventory" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToInventory</bpmn:incoming>
      <bpmn:outgoing>Flow_InventoryDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_InventoryDone" sourceRef="ReserveInventory" targetRef="JoinFulfillment" />
    <bpmn:sequenceFlow id="Flow_ToPayment" sourceRef="ForkFulfillment" targetRef="ProcessPayment" />
    <bpmn:serviceTask id="ProcessPayment" name="Process payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="z9s-sim-payment" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToPayment</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentDone</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_PaymentDone" sourceRef="ProcessPayment" targetRef="JoinFulfillment" />
    <bpmn:boundaryEvent id="PaymentDeclined" name="Payment declined" attachedToRef="ProcessPayment">
      <bpmn:outgoing>Flow_ToNotify</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_PaymentDeclined" errorRef="Error_PaymentDeclined" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_ToNotify" sourceRef="PaymentDeclined" targetRef="NotifyCustomer" />
    <bpmn:serviceTask id="NotifyCustomer" name="Notify customer">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="z9s-sim-notify" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCancelled</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToCancelled" sourceRef="NotifyCustomer" targetRef="OrderCancelled" />
    <bpmn:endEvent id="OrderCancelled" name="Order cancelled">
      <bpmn:incoming>Flow_ToCancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="JoinFulfillment" name="">
      <bpmn:incoming>Flow_InventoryDone</bpmn:incoming>
      <bpmn:incoming>Flow_PaymentDone</bpmn:incoming>
      <bpmn:outgoing>Flow_ToShip</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_ToShip" sourceRef="JoinFulfillment" targetRef="ShipOrder" />
    <bpmn:serviceTask id="ShipOrder" name="Ship order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="z9s-sim-ship" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToShip</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPickup</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToPickup" sourceRef="ShipOrder" targetRef="WaitForPickup" />
    <bpmn:intermediateCatchEvent id="WaitForPickup" name="Wait for pickup">
      <bpmn:incoming>Flow_ToPickup</bpmn:incoming>
      <bpmn:outgoing>Flow_ToConfirm</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_WaitForPickup">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">="PT45S"</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_ToConfirm" sourceRef="WaitForPickup" targetRef="ConfirmDelivery" />
    <bpmn:userTask id="ConfirmDelivery" name="Confirm delivery">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="confirm-delivery" />
        <zeebe:assignmentDefinition candidateGroups="support" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToConfirm</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDelivered</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ToDelivered" sourceRef="ConfirmDelivery" targetRef="OrderDelivered" />
    <bpmn:endEvent id="OrderDelivered" name="Order delivered">
      <bpmn:incoming>Flow_ToDelivered</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:error id="Error_PaymentDeclined" name="Payment declined" errorCode="PAYMENT_DECLINED" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="order-fulfillment">
      <bpmndi:BPMNShape id="OrderReceived_di" bpmnElement="OrderReceived">
        <dc:Bounds x="160" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="142" y="225" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ValidateOrder_di" bpmnElement="ValidateOrder">
        <dc:Bounds x="250" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OrderValid_di" bpmnElement="OrderValid" isMarkerVisible="true">
        <dc:Bounds x="400" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="394" y="145" width="62" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OrderRejected_di" bpmnElement="OrderRejected">
        <dc:Bounds x="407" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="389" y="345" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ForkFulfillment_di" bpmnElement="ForkFulfillment">
        <dc:Bounds x="500" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReserveInventory_di" bpmnElement="ReserveInventory">
        <dc:Bounds x="590" y="70" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ProcessPayment_di" bpmnElement="ProcessPayment">
        <dc:Bounds x="590" y="250" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentDeclined_di" bpmnElement="PaymentDeclined">
        <dc:Bounds x="622" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="576" y="355" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifyCustomer_di" bpmnElement="NotifyCustomer">
        <dc:Bounds x="700" y="380" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OrderCancelled_di" bpmnElement="OrderCancelled">
        <dc:Bounds x="852" y="402" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="831" y="445" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="JoinFulfillment_di" bpmnElement="JoinFulfillment">
        <dc:Bounds x="730" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ShipOrder_di" bpmnElement="ShipOrder">
        <dc:Bounds x="820" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WaitForPickup_di" bpmnElement="WaitForPickup">
        <dc:Bounds x="962" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="943" y="225" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ConfirmDelivery_di" bpmnElement="ConfirmDelivery">
        <dc:Bounds x="1040" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OrderDelivered_di" bpmnElement="OrderDelivered">
        <dc:Bounds x="1182" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1162" y="225" width="77" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToValidate_di" bpmnElement="Flow_ToValidate">
        <di:waypoint x="196" y="200" />
        <di:waypoint x="250" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToValidGateway_di" bpmnElement="Flow_ToValidGateway">
        <di:waypoint x="350" y="200" />
        <di:waypoint x="400" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Valid_di" bpmnElement="Flow_Valid">
        <di:waypoint x="450" y="200" />
        <di:waypoint x="500" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="463" y="182" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Invalid_di" bpmnElement="Flow_Invalid">
        <di:waypoint x="425" y="225" />
        <di:waypoint x="425" y="302" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="432" y="255" width="33" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToInventory_di" bpmnElement="Flow_ToInventory">
        <di:waypoint x="525" y="175" />
        <di:waypoint x="525" y="110" />
        <di:waypoint x="590" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_InventoryDone_di" bpmnElement="Flow_InventoryDone">
        <di:waypoint x="690" y="110" />
        <di:waypoint x="755" y="110" />
        <di:waypoint x="755" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToPayment_di" bpmnElement="Flow_ToPayment">
        <di:waypoint x="525" y="225" />
        <di:waypoint x="525" y="290" />
        <di:waypoint x="590" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentDone_di" bpmnElement="Flow_PaymentDone">
        <di:waypoint x="690" y="290" />
        <di:waypoint x="755" y="290" />
        <di:waypoint x="755" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToNotify_di" bpmnElement="Flow_ToNotify">
        <di:waypoint x="640" y="348" />
        <di:waypoint x="640" y="420" />
        <di:waypoint x="700" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToCancelled_di" bpmnElement="Flow_ToCancelled">
        <di:waypoint x="800" y="420" />
        <di:waypoint x="852" y="420" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToShip_di" bpmnElement="Flow_ToShip">
        <di:waypoint x="780" y="200" />
        <di:waypoint x="820" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToPickup_di" bpmnElement="Flow_ToPickup">
        <di:waypoint x="920" y="200" />
        <di:waypoint x="962" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToConfirm_di" bpmnElement="Flow_ToConfirm">
        <di:waypoint x="998" y="200" />
        <di:waypoint x="1040" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDelivered_di" bpmnElement="Flow_ToDelivered">
        <di:waypoint x="1140" y="200" />
        <di:waypoint x="1182" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
