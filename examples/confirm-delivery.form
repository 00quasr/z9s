{
  "components": [
    {
      "type": "text",
      "text": "### Confirm delivery\n\nCheck the shipment and confirm the order reached the customer.",
      "id": "Text_Header",
      "layout": { "row": "row_0", "columns": null }
    },
    {
      "type": "textfield",
      "id": "Field_OrderId",
      "key": "orderId",
      "label": "Order ID",
      "readonly": true,
      "layout": { "row": "row_1", "columns": null }
    },
    {
      "type": "checkbox",
      "id": "Field_DeliveryOk",
