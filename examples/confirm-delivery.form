    },
    {
      "type": "textarea",
      "id": "Field_DeliveryNotes",
      "key": "deliveryNotes",
      "label": "Notes",
      "layout": { "row": "row_3", "columns": null }
    }
  ],
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.8.0",
